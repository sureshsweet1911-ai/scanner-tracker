
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PM85 Scanner - UMA7</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            min-height: 100vh;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        h1 {
            font-size: 1.3em;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .subtitle { color: #8892b0; font-size: 0.85em; margin-bottom: 25px; }
        .step-box {
            background: rgba(255,255,255,0.05);
            border-radius: 15px;
            padding: 25px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 15px;
        }
        .step-title { color: #00d2ff; font-size: 0.9em; margin-bottom: 15px; font-weight: 600; }
        .shift-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .shift-btn {
            padding: 18px 10px;
            border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.05);
            color: #fff;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
        }
        .shift-btn:active, .shift-btn.selected {
            border-color: #00d2ff;
            background: rgba(0,210,255,0.2);
            transform: scale(0.95);
        }
        .scan-input {
            width: 100%;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid rgba(255,255,255,0.2);
            background: rgba(0,0,0,0.3);
            color: #fff;
            font-size: 1.1em;
            text-align: center;
            margin-top: 10px;
        }
        .scan-input:focus { border-color: #00d2ff; outline: none; }
        .hidden { display: none; }
        .success-msg {
            background: rgba(0,255,0,0.1);
            border: 1px solid #00ff00;
            border-radius: 10px;
            padding: 15px;
            color: #00ff00;
            font-weight: bold;
            margin-top: 15px;
        }
        .error-msg {
            background: rgba(255,0,0,0.1);
            border: 1px solid #ff6b6b;
            border-radius: 10px;
            padding: 15px;
            color: #ff6b6b;
            font-weight: bold;
            margin-top: 15px;
        }
        .action-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 15px;
        }
        .action-btn {
            padding: 15px;
            border-radius: 12px;
            border: none;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
        }
        .btn-take { background: linear-gradient(135deg, #00d2ff, #3a7bd5); color: #fff; }
        .btn-return { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }
        .current-info {
            color: #8892b0;
            font-size: 0.8em;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <h1>📱 PM85 Scanner Tracker</h1>
    <p class="subtitle">UMA7 — Scan to Track</p>

    <!-- STEP 1: Select Shift -->
    <div class="step-box" id="step1">
        <div class="step-title">STEP 1: Select Your Shift</div>
        <div class="shift-grid">
            <button class="shift-btn" id="btn-A" onclick="selectShift('A')">A Shift<br><small>07:00 - 17:00</small></button>
            <button class="shift-btn" id="btn-G" onclick="selectShift('G')">G Shift<br><small>09:00 - 19:00</small></button>
            <button class="shift-btn" id="btn-B" onclick="selectShift('B')">B Shift<br><small>11:00 - 21:00</small></button>
            <button class="shift-btn" id="btn-C" onclick="selectShift('C')">C Shift<br><small>21:00 - 07:00</small></button>
        </div>
    </div>

    <!-- STEP 2: Select Action -->
    <div class="step-box hidden" id="step2">
        <div class="step-title">STEP 2: Select Action</div>
        <div class="action-btns">
            <button class="action-btn btn-take" onclick="selectAction('TAKE')">📤 TAKE</button>
            <button class="action-btn btn-return" onclick="selectAction('RETURN')">📥 RETURN</button>
        </div>
    </div>

    <!-- STEP 3: Scan Associate ID -->
    <div class="step-box hidden" id="step3">
        <div class="step-title">STEP 3: Scan Your ID Badge</div>
        <input type="text" class="scan-input" id="associate-input" placeholder="Scan Associate ID..." autofocus>
    </div>

    <!-- STEP 4: Scan Scanner ID -->
    <div class="step-box hidden" id="step4">
        <div class="step-title">STEP 4: Scan Scanner Barcode</div>
        <input type="text" class="scan-input" id="scanner-input" placeholder="Scan Scanner ID (PM85-XXX)...">
    </div>

    <!-- Result Message -->
    <div id="result-area"></div>

    <!-- Current Info -->
    <div class="current-info" id="current-info"></div>

    <script>
        var CONFIG = {
            QUIP_TOKEN: 'Q0JHOU1BTktQT3g=|1817742605|oGJuGkrOr7qHk/7ctbOX+BlGYLdZsuTP6xIUoOLyb8w=',
            QUIP_DOC_ID: 'dhUCA4htEONI',
            SITE: 'UMA7'
        };

        var selectedShift = '';
        var selectedAction = '';
        var associateId = '';

        function selectShift(shift) {
            selectedShift = shift;
            // Highlight selected button
            document.querySelectorAll('.shift-btn').forEach(function(b) { b.classList.remove('selected'); });
            document.getElementById('btn-' + shift).classList.add('selected');
            // Show step 2
            document.getElementById('step2').classList.remove('hidden');
            document.getElementById('current-info').textContent = 'Shift: ' + shift;
        }

        function selectAction(action) {
            selectedAction = action;
            // Show step 3
            document.getElementById('step3').classList.remove('hidden');
            document.getElementById('associate-input').focus();
            document.getElementById('current-info').textContent = 'Shift: ' + selectedShift + ' | Action: ' + action;
        }

        // Step 3: Associate ID scanned (Enter key triggers)
        document.getElementById('associate-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                var val = this.value.trim();
                if (val.length > 0) {
                    associateId = val;
                    document.getElementById('step4').classList.remove('hidden');
                    document.getElementById('scanner-input').focus();
                    document.getElementById('current-info').textContent = 'Shift: ' + selectedShift + ' | Action: ' + selectedAction + ' | Associate: ' + associateId;
                }
            }
        });

        // Step 4: Scanner ID scanned (Enter key triggers)
        document.getElementById('scanner-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                var scannerId = this.value.trim();
                if (scannerId.length > 0) {
                    submitRecord(scannerId);
                }
            }
        });

        function submitRecord(scannerId) {
            var now = new Date();
            var timestamp = now.toLocaleString('en-IN', { hour12: true });
            var record = timestamp + ' | ' + selectedShift + ' | ' + associateId + ' | ' + scannerId + ' | ' + selectedAction + ' | ' + CONFIG.SITE;

            // Send to Quip
            var xhr = new XMLHttpRequest();
            xhr.open('POST', 'https://platform.quip-amazon.com/1/messages/new', true);
            xhr.setRequestHeader('Authorization', 'Bearer ' + CONFIG.QUIP_TOKEN);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onload = function() {
                if (xhr.status === 200 || xhr.status === 201) {
                    showResult('success', '✅ Recorded! ' + selectedAction + ' — ' + scannerId + ' by ' + associateId);
                } else {
                    showResult('error', '❌ Failed to save. Try again.');
                }
            };
            xhr.onerror = function() {
                showResult('error', '❌ Network error. Check connection.');
            };
            xhr.send('thread_id=' + CONFIG.QUIP_DOC_ID + '&content=' + encodeURIComponent(record));

            // Reset for next scan
            resetForNext();
        }

        function showResult(type, msg) {
            var area = document.getElementById('result-area');
            area.innerHTML = '<div class="' + type + '-msg">' + msg + '</div>';
            setTimeout(function() { area.innerHTML = ''; }, 5000);
        }

        function resetForNext() {
            // Keep shift and action, reset scan fields for next associate
            document.getElementById('associate-input').value = '';
            document.getElementById('scanner-input').value = '';
            document.getElementById('step4').classList.add('hidden');
            document.getElementById('associate-input').focus();
            associateId = '';
        }
    </script>
</body>
</html>

